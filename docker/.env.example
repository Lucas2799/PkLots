# Copie para docker/.env e ajuste os valores (docker/.env não vai para o git)

# Banco de dados
POSTGRES_USUARIO=pklots_admin
POSTGRES_SENHA=SenhaForteAqui123!
POSTGRES_BANCO=pklots_core
POSTGRES_PORTA=5432

# API
AMBIENTE=Production
API_PORTA=8080
# Swagger UI em /swagger (desative em produção)
SWAGGER_HABILITADO=true
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_CHAVE=troque_por_uma_chave_aleatoria_com_pelo_menos_32_caracteres

# Microsserviço LPR (Python), publicado só no localhost para testes
LPR_PORTA=5000

# Gateway Nginx (porta publicada no host)
GATEWAY_PORTA=8000
