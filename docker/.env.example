# Copie para docker/.env e preencha (docker/.env não vai para o git).
# O compose NÃO sobe sem POSTGRES_SENHA e JWT_CHAVE, e a API recusa os valores de exemplo do projeto.

# ---------- Obrigatórios ----------
# Senha do banco. Gere com: openssl rand -base64 24
# (vale na criação do banco; para trocar depois: ALTER USER pklots_admin PASSWORD '...')
POSTGRES_SENHA=
# Chave de assinatura dos logins (mínimo 32 caracteres). Gere com: openssl rand -base64 48
# Trocar a chave desconecta todos os usuários (precisam entrar de novo).
JWT_CHAVE=

# ---------- Banco ----------
POSTGRES_USUARIO=pklots_admin
POSTGRES_BANCO=pklots_core
POSTGRES_PORTA=5432

# ---------- API ----------
AMBIENTE=Production
API_PORTA=8080
# Swagger UI em /swagger: deixe false em produção
SWAGGER_HABILITADO=false
# Empresa/pátio/usuários de demonstração em banco vazio (senhas públicas): só para testes
DADOS_DEMONSTRACAO=false

# Endereço público do sistema, como o cliente acessa (vai no QR do ticket).
# Em produção: o domínio com HTTPS, ex.: https://pklots.com.br (se mudar, tickets já impressos param de abrir)
URL_PUBLICA=http://localhost:8000

# ---------- Leitura de placas (Python), só no localhost para testes ----------
LPR_PORTA=5000

# ---------- Gateway ----------
GATEWAY_PORTA=8000
# HTTPS: ativado quando docker/ssl/cert.pem e key.pem existem (ver docker/ssl/LEIA-ME.md)
GATEWAY_PORTA_HTTPS=8443

# ---------- Superusuário ----------
# Não há senha em arquivo. Crie (ou recupere) pelo servidor:
#   podman exec -it pklots-dotnet-api ./PkLots.Api criar-superadmin --email voce@empresa.com
