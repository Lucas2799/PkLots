# syntax=docker/dockerfile:1
# =========================================
# PkLots.Api - imagem enxuta
# Publish self-contained + trimming sobre runtime-deps Alpine:
# a imagem final não tem SDK, nem runtime .NET compartilhado, nem ICU.
# Contexto de build: src/.net
# =========================================

# =========================================
# Build / Publish
# =========================================
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
ARG TARGETARCH
WORKDIR /src

# Restaurar dependências primeiro (camada cacheada enquanto os .csproj não mudam)
COPY PkLots.Api/PkLots.Api.csproj PkLots.Api/
COPY PkLots.Application/PkLots.Application.csproj PkLots.Application/
COPY PkLots.Core/PkLots.Core.csproj PkLots.Core/
COPY PkLots.Infrastructure/PkLots.Infrastructure.csproj PkLots.Infrastructure/
RUN dotnet restore PkLots.Api/PkLots.Api.csproj \
        --runtime linux-musl-${TARGETARCH/amd64/x64} \
        -p:PublishTrimmed=true

# Copiar código-fonte e publicar
COPY PkLots.Api/ PkLots.Api/
COPY PkLots.Application/ PkLots.Application/
COPY PkLots.Core/ PkLots.Core/
COPY PkLots.Infrastructure/ PkLots.Infrastructure/
RUN dotnet publish PkLots.Api/PkLots.Api.csproj \
        -c Release \
        --runtime linux-musl-${TARGETARCH/amd64/x64} \
        --self-contained true \
        --no-restore \
        -p:PublishTrimmed=true \
        -p:TrimMode=partial \
        -p:InvariantGlobalization=true \
        -p:JsonSerializerIsReflectionEnabledByDefault=true \
        -p:DebugType=none \
        -p:GenerateDocumentationFile=false \
        -o /app

# =========================================
# Runtime
# =========================================
FROM mcr.microsoft.com/dotnet/runtime-deps:8.0-alpine AS final
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=true \
    DOTNET_gcServer=0 \
    DOTNET_GCHeapHardLimitPercent=0x4B

# Usuário não-root já existente na imagem base (UID 1654)
COPY --from=build --chown=$APP_UID:$APP_UID /app .
USER $APP_UID

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/health >/dev/null || exit 1

ENTRYPOINT ["./PkLots.Api"]
